# Normalize text files to LF in the repo and on checkout, on every OS
* text=auto eol=lf

# Windows-only scripts need CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets (tilesets, sprites, fonts): never touch line endings or diff
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
